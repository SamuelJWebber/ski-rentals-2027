#!/bin/sh
# Pre-push checks for this public repository (installed by tools/install-hooks.sh).
# 1. The commits being pushed: noreply author/committer emails; no local paths, stray emails, tokens or
#    booking wording on any added line.
# 2. The site checks: costs, recheck blocks, privacy, anchors, refund windows and the review-finding checks.
repo="$(git rev-parse --show-toplevel)" || exit 1
case "$(uname -s 2>/dev/null)" in
  # On Windows "python3" is often the Microsoft Store alias stub, which fails; try it last.
  MINGW*|MSYS*|CYGWIN*) candidates="python py python3" ;;
  *) candidates="python3 python" ;;
esac
py=""
for c in $candidates; do
  if command -v "$c" >/dev/null 2>&1 && "$c" -c 'import sys; sys.exit(0 if sys.version_info >= (3, 8) else 1)' >/dev/null 2>&1; then
    py="$c"
    break
  fi
done
if [ -z "$py" ]; then
  echo "pre-push: no working Python 3 found; install one, or push with --no-verify after running tools/sitecheck.py" >&2
  exit 1
fi
if [ -n "$PREPUSH_PRINT_PYTHON" ]; then
  echo "$py"   # for tests/test_prepush.py: which interpreter the hook would use
  exit 0
fi
"$py" "$repo/tools/prepush.py" || exit 1
"$py" "$repo/tools/sitecheck.py" >/dev/null || { "$py" "$repo/tools/sitecheck.py"; exit 1; }
exit 0
